# OBRIGATÓRIO: chave do Gemini (grátis em https://aistudio.google.com/apikey).
# Sem ela o servidor não abre. Nunca suba o .env para o GitHub.
GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI

# Opcional: senha da área Admin (admin.html), mínimo 8 caracteres.
# Sem ela, o Admin só abre no próprio computador do servidor.
# Obrigatória quando NODE_ENV=production. Tire o # para ativar.
# ADMIN_SENHA=defina_uma_senha_sua

# Opcionais
# PORT=3000
# GEMINI_MODEL=gemini-3.5-flash-lite
